# ---------------------------------------------------------------
# Premium App Sale — environment variables (placeholders only).
# Copy to .env and fill in. NEVER commit real values.
# ---------------------------------------------------------------

NODE_ENV=development

# Public base URL of this site, no trailing slash. Used to build the
# RaksmeyPay success_url and is the only allowed callback origin.
APP_URL=http://localhost:3000

# PostgreSQL. With docker compose: postgresql://premium:change-me-local-only@127.0.0.1:5432/premium_app_sale
# With `npm run db:embedded`:     postgresql://postgres:postgres@127.0.0.1:54329/premium_app_sale
DATABASE_URL=postgresql://premium:change-me-local-only@127.0.0.1:5432/premium_app_sale

# 32+ random bytes, base64. Generate with: npm run keys:generate
AUTH_SECRET=

# AES-256-GCM key for stock credentials: exactly 32 bytes, base64.
# Losing this key makes all stored inventory unreadable. Back it up offline.
INVENTORY_ENCRYPTION_KEY=

# Protects /api/cron/release-reservations (send as "Authorization: Bearer <value>")
CRON_SECRET=

# ---------------- Payments ----------------
# "mock" (local testing, never in production) or "raksmeypay"
PAYMENT_PROVIDER=mock

RAKSMEYPAY_BASE_URL=https://www.raksmeypay.com
RAKSMEYPAY_PROFILE_ID=
RAKSMEYPAY_PROFILE_KEY=
# The "API Key" configured for webhooks in the RaksmeyPay dashboard (sent as X-Api-Key)
RAKSMEYPAY_WEBHOOK_API_KEY=
# Optional fixed payment option for the hosted page: bakong | aba | binance | paypal (empty = let customer choose)
RAKSMEYPAY_PAYMENT_OPTION=
# 1 = KHQR branded card, 2 = plain QR
RAKSMEYPAY_QR_TEMPLATE=1
# Webhook timestamp tolerance in seconds (replay protection)
RAKSMEYPAY_WEBHOOK_TOLERANCE_SECONDS=900
# Success URL validity window in seconds (documented sample uses 180)
RAKSMEYPAY_SUCCESS_MAX_AGE_SECONDS=180

# ---------------- Email ----------------
# "console" logs links to the server console (dev only). Implement SMTP/API adapter for production.
EMAIL_TRANSPORT=console
EMAIL_FROM="Premium App Sale <no-reply@example.com>"
# Require a verified email before checkout
REQUIRE_EMAIL_VERIFICATION=false

# ---------------- Seed (development only) ----------------
SEED_ADMIN_EMAIL=admin@example.com
# Choose your own strong password; it is never stored in source code.
SEED_ADMIN_PASSWORD=
